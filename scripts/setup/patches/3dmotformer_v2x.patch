 from utils.data_util import NuScenesClasses
 
 
+def _motformer_corners(box):
+    # 框格式是x y z width length height yaw
+    x, y, _, width, length, _, yaw = [float(value) for value in box]
+    local = np.array(
+        [
+            [length / 2.0, width / 2.0],
+            [-length / 2.0, width / 2.0],
+            [-length / 2.0, -width / 2.0],
+            [length / 2.0, -width / 2.0],
+        ],
+        dtype=np.float64,
+    )
+    cosine, sine = math.cos(yaw), math.sin(yaw)
+    rotation = np.array([[cosine, -sine], [sine, cosine]], dtype=np.float64)
+    return local @ rotation.T + np.array([x, y])
+
+
+def _valid_polygon(corners):
+    polygon = Polygon(corners)
+    if not polygon.is_valid:
+        polygon = polygon.buffer(0)
+    return polygon
+
+
+def _bev_iou_matrix(det_box, gt_box):
+    # 只计算BEV相交的框，结果与全量IoU一致
+    det_np = det_box.detach().cpu().numpy()
+    gt_np = gt_box.detach().cpu().numpy()
+    iou = torch.zeros((det_np.shape[0], gt_np.shape[0]), dtype=torch.float32)
+    if det_np.shape[0] == 0 or gt_np.shape[0] == 0:
+        return iou
+    det_polys = [_valid_polygon(_motformer_corners(box)) for box in det_np]
+    gt_polys = [_valid_polygon(_motformer_corners(box)) for box in gt_np]
+    pairs = STRtree(gt_polys).query(det_polys, predicate="intersects")
+    if getattr(pairs, "size", 0) == 0:
+        return iou
+    for row, column in zip(pairs[0].tolist(), pairs[1].tolist()):
+        poly_a = det_polys[int(row)]
+        poly_b = gt_polys[int(column)]
+        if poly_a.is_empty or poly_b.is_empty:
+            continue
+        intersection = poly_a.intersection(poly_b).area
+        union = poly_a.area + poly_b.area - intersection
+        if union > 0.0:
+            iou[int(row), int(column)] = float(intersection / union)
+    return iou
+
